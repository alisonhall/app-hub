{
  "name": "app-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Root launcher that discovers, starts, and proxies to sub-apps declared with an app-hub.config.json",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/check-deps.js",
    "start": "node server.js",
    "postinstall": "node scripts/install-apps.js && node scripts/check-deps.js",
    "check-deps": "node scripts/check-deps.js",
    "test": "node --test"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3"
  }
}
